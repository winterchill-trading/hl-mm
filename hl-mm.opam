opam-version: "2.0"
synopsis: "Market maker for hl-sim"
maintainer: ["winterchill-trading"]
authors: ["winterchill-trading"]
license: "MIT"
homepage: "https://github.com/winterchill-trading/hl-mm"
bug-reports: "https://github.com/winterchill-trading/hl-mm/issues"
depends: [
  "ocaml"
  "dune" {>= "3.17"}
  "core"
  "hl-protocol"
  "fixed-decimal"
  "ppx_jane"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/winterchill-trading/hl-mm.git"
